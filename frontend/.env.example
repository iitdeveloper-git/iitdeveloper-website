# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database Configuration
# Option 1: Neon Database (Recommended - works everywhere)
# Sign up: https://neon.tech (free tier available)
# DATABASE_URL=postgresql://user:pass@ep-xxx-xxx.us-east-2.aws.neon.tech/iitdeveloper?sslmode=require

# Option 2: Local PostgreSQL (Development only)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=iitdeveloper
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Feature Flags
NEXT_PUBLIC_ENABLE_CHATBOT=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Email Configuration (Resend API)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=noreply@iitdeveloper.com
FROM_NAME=IITDeveloper
SALES_EMAIL=info@iitdeveloper.com

# Public contact email
NEXT_PUBLIC_CONTACT_EMAIL=info@iitdeveloper.com

# ─── IITDeveloper Dispatch Gateway ───────────────────────────────────────────
# PostgreSQL for iitdeveloper_prod (client leads)
IITD_DATABASE_URL=postgresql://iitd_app:iitd_dispatch_2026@core_postgres:5432/iitdeveloper_prod

# Sendrin (GNS) internal call — API key for the IITDeveloper tenant application
# key prefix: ueRj3SfsfV  (full key in Vault / .env.production on VPS)
SENDRIN_INTERNAL_API_KEY=gns_ueRj3SfsfV...full_key_here
SENDRIN_INTERNAL_URL=http://gns_api:5000
